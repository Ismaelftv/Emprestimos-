# ===== Obrigatórias em produção =====
DOMAIN=caixa.seudominio.com.br          # domínio apontando para o servidor (Caddy emite o HTTPS sozinho)
PUBLIC_URL=https://caixa.seudominio.com.br
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=                              # openssl rand -hex 32
FILE_KEY=                                # openssl rand -base64 32  (GUARDE UMA CÓPIA FORA DO SERVIDOR)
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com        # login do 1º administrador
BOOTSTRAP_ADMIN_PASSWORD=                # vazio = senha provisória Caixa@Trocar2026 (TROQUE ao entrar). Ou defina a sua aqui.
# ===== E-mail (recuperação de senha, convite, recibo) =====
SMTP_URL=smtps://usuario:senha@smtp.seuprovedor.com:465
SMTP_FROM=Caixa <no-reply@seudominio.com.br>
# ===== Notificações push (opcional): npx web-push generate-vapid-keys =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br
